# -------------------------------------------------------
# APPLICATION
# -------------------------------------------------------
APP_ENV=development

# -------------------------------------------------------
# DATABASE
# -------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# -------------------------------------------------------
# NIRIKSHA AI
# -------------------------------------------------------
NIRIKSHA_API_KEY=nai_your_api_key_here

# -------------------------------------------------------
# TELEMETRY MODE
# Controls how the app exports observability data.
#
# Options:
#   grpc-direct     → App uses Niriksha SDK → gRPC → grpc-ingest.niriksha.ai:443
#   http-direct     → App uses OTLP HTTP   → HTTPS → ingest.niriksha.ai
#   grpc-collector  → App uses OTLP gRPC   → OTel Collector → Niriksha AI
#   http-collector  → App uses OTLP HTTP   → OTel Collector → Niriksha AI
# -------------------------------------------------------
TELEMETRY_MODE=grpc-direct

# -------------------------------------------------------
# OTEL COLLECTOR ENDPOINTS
# Only required when TELEMETRY_MODE is grpc-collector
# or http-collector.
# -------------------------------------------------------
OTEL_COLLECTOR_GRPC_ENDPOINT=otel-collector:4317
OTEL_COLLECTOR_HTTP_ENDPOINT=http://otel-collector:4318

# -------------------------------------------------------
# NIRIKSHA DIRECT ENDPOINTS
# Only required when TELEMETRY_MODE is http-direct.
# grpc-direct uses these internally via the SDK.
# -------------------------------------------------------
NIRIKSHA_GRPC_ENDPOINT=grpc-ingest.niriksha.ai:443
NIRIKSHA_HTTP_ENDPOINT=https://ingest.niriksha.ai
